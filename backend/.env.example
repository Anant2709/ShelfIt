# Copy to backend/.env and fill in real values. Never commit .env.

# Default is a local SQLite file under data/shelfit.db when unset.
# Interview primary: Neon or Supabase (see docs/postgres.md).
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CLASSIFIER_BACKEND=vision_llm

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Optional: packaged-product nutrition when Open Food Facts misses.
EXA_API_KEY=

ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_VERSION=
